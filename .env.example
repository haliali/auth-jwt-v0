# ⚙️ Variáveis de Ambiente

# Banco de Dados MongoDB
DB_USER=seu_usuario_mongodb
DB_PASS=sua_senha_mongodb
DB_NAME=auth-db

# JWT Secret (chave secreta para assinar tokens)
SECRET=sua_chave_secreta_muito_segura_aqui

# Servidor
PORT=3000

# Exemplo de valores:
# DB_USER=haliali
# DB_PASS=abc123XYZ@!
# SECRET=minha_chave_super_secreta_2024
